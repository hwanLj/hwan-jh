        /* Slow Zoom Background Animation for Hero */
        @keyframes slowZoom {
            0% { transform: scale(1); }
            100% { transform: scale(1.1); }
        }
        .hero-bg {
            animation: slowZoom 20s linear infinite alternate;
        }

        /* High-end Fade-up Animation */
        .reveal-up {
            opacity: 0;
            transform: translateY(40px);
            transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal-up.is-visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Image Reveal Mask Effect */
        .reveal-mask {
            position: relative;
            overflow: hidden;
        }
        .reveal-mask::after {
            content: '';
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: #111;
            transform-origin: right;
            transition: transform 1.2s cubic-bezier(0.19, 1, 0.22, 1);
            z-index: 10;
        }
        .reveal-mask.is-visible::after {
            transform: scaleX(0);
        }

        /* Project Hover Effect (Corporate Style) */
        .project-item {
            position: relative;
            overflow: hidden;
        }
        .project-item img {
