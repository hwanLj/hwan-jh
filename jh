        }
        .project-item:hover img {
            transform: scale(1.03);
        }
        .project-info {
            position: absolute;
            bottom: -20px;
            left: 0;
            width: 100%;
            padding: 2rem;
            background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 100%);
            color: white;
            opacity: 0;
            transition: all 0.5s ease;
        }
        .project-item:hover .project-info {
