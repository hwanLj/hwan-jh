            opacity: 1;
        }

        /* Navbar transitions */
        .nav-scrolled {
            background-color: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #eaeaea;
            color: #111 !important;
